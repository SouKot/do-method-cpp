<ParameterList><!--{ -->
    <Parameter name="Solver" type="string" value="BLOCK GMRES"/>
    <Parameter name="Verbose" type="bool" value="false"/>
    
    <ParameterList name="BLOCK GMRES">
	<Parameter name="Orthogonalization" type="string" value="DGKS"/>
